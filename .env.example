# API Configuration
API_BASE_URL=https://your-api.com/api/v1
SOCKET_URL=wss://your-socket-server.com

# AI Services
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Social Login
GOOGLE_WEB_CLIENT_ID=your_google_client_id
FACEBOOK_APP_ID=your_facebook_app_id

# Maps & Location
GOOGLE_MAPS_API_KEY=your_maps_api_key

# Security
ENCRYPTION_KEY=your_32_character_encryption_key_here

# App Center (CodePush)
APPCENTER_SECRET_IOS=your_ios_secret
APPCENTER_SECRET_ANDROID=your_android_secret

# MediaPipe Models
MEDIAPIPE_MODELS_URL=https://storage.googleapis.com/mediapipe-models

# Analytics
MIXPANEL_TOKEN=your_mixpanel_token
AMPLITUDE_API_KEY=your_amplitude_key

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_AR_FEATURES=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_OFFLINE_MODE=true

# Development
DEBUG_MODE=true
LOG_LEVEL=debug
